{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "destination": "/",
      "source": "/((?!api(?:/|$)).*)"
    },
    {
      "destination": "/api/platform?__route=:route*",
      "source": "/api/platform/:route*"
    },
    {
      "destination": "/api/copilotkit?__route=:route*",
      "source": "/api/copilotkit/:route*"
    },
    {
      "destination": "/api/copilot-mcp?__route=:route*",
      "source": "/api/copilot-mcp/:route*"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/api/(mcp|copilotkit)(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "installCommand": "bun install --frozen-lockfile",
  "functions": {
    "api/copilotkit.ts": { "includeFiles": "node_modules/{uuid,pkce-challenge}/**" },
    "api/copilot-mcp.ts": { "includeFiles": "node_modules/{uuid,pkce-challenge}/**" },
    "api/mcp.ts": { "includeFiles": "node_modules/{uuid,pkce-challenge}/**" }
  },
  "bunVersion": "1.4.x",
  "git": {
    "deploymentEnabled": false
  },
  "crons": [{"path":"/api/platform-worker","schedule":"0 2 * * *"}]
}
