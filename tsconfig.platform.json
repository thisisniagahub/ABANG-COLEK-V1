{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "types": [
      "bun",
      "node"
    ],
    "allowJs": false
  },
  "include": [
    "server/**/*.ts",
    "shared/**/*.ts",
    "scripts/**/*.ts",
    "tests/platform/**/*.ts",
    "tests/jev/**/*.ts",
    "tests/architecture/**/*.ts",
    "api/**/*.ts",
    "tests/copilot/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "skills",
    "tests/architecture/fixtures"
  ]
}
