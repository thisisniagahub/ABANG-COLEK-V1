                    "test:e2e":  "playwright test -c tests/playwright.config.ts",
                    "qa:server":  "bun scripts/qa-platform.ts",
                    "preview":  "vite preview",
                    "clean":  "bun scripts/clean.ts",
                    "lint":  "tsc --noEmit \u0026\u0026 tsc --noEmit -p tsconfig.platform.json"
                },
