    "scripts":  {
                    "dev":  "bun scripts/dev.ts",
                    "dev:ui":  "vite --port=3000 --strictPort",
                    "build":  "vite build \u0026\u0026 bun scripts/prerender-public.ts",
                    "server":  "bun server/index.ts",
