{
    "name":  "abangcolek-platform",
    "private":  true,
    "version":  "0.1.0",
    "type":  "module",
    "scripts":  {
                    "dev":  "bun scripts/dev.ts",
    "dev:ui": "vite --host 127.0.0.1 --port=3000 --strictPort",
                    "build":  "vite build && bun scripts/prerender-public.ts",
                    "server":  "bun server/index.ts",
                    "test:platform":  "bun test --isolate ./tests/jev ./tests/platform ./tests/copilot ./tests/frontend ./tests/architecture ./tests/ext ./tests/dashboard-model.test.ts ./tests/landing-brand-theme.test.ts",
                    "test:jev":  "bun test --isolate ./tests/jev",
                    "test:platform-suite":  "bun test --isolate ./tests/platform",
                    "test:copilot":  "bun test --isolate ./tests/copilot",
                    "test:frontend":  "bun test --isolate ./tests/frontend",
                    "test:architecture":  "bun test --isolate ./tests/architecture",
                    "test:ext":  "bun test --isolate ./tests/ext",
                    "test":  "bun run test:jev && bun run test:platform-suite && bun run test:copilot && bun run test:frontend && bun run test:architecture && bun run test:ext && bun test --isolate ./tests/dashboard-model.test.ts ./tests/landing-brand-theme.test.ts",
                    "test:e2e":  "playwright test -c tests/playwright.config.ts",
                    "qa:server":  "bun scripts/qa-platform.ts",
                    "preview":  "vite preview",
                    "clean":  "bun scripts/clean.ts",
                    "lint":  "tsc --noEmit && tsc --noEmit -p tsconfig.platform.json"
                },
    "dependencies":  {
                         "@ag-ui/client":  "1.0.2",
                         "@ag-ui/core":  "1.0.2",
                         "@copilotkit/a2ui-renderer":  "1.79.1",
                         "@copilotkit/mcp-apps-renderer":  "1.79.1",
                         "@copilotkit/react-core":  "1.79.1",
                         "@copilotkit/runtime":  "1.79.1",
                         "@google/genai":  "^1.43.0",
                         "@modelcontextprotocol/client":  "2.0.0",
                         "@modelcontextprotocol/core":  "2.0.0",
                         "@modelcontextprotocol/ext-apps":  "2.0.3",
                         "@modelcontextprotocol/sdk":  "1.32.1",
                         "@modelcontextprotocol/server":  "2.0.0",
                         "@supabase/server":  "^1.9.0",
                         "@supabase/supabase-js":  "^2.117.2",
                         "@tailwindcss/vite":  "^4.1.14",
                         "@vis.gl/react-google-maps":  "^1.10.1",
                         "@vitejs/plugin-react":  "^5.0.4",
                         "clsx":  "^2.1.1",
                         "date-fns":  "^4.1.0",
                         "dotenv":  "^17.2.3",
                         "firebase":  "^12.19.0",
                         "framer-motion":  "^12.34.3",
                         "lucide-react":  "^0.546.0",
                         "motion":  "^12.23.24",
                         "react":  "^19.0.0",
                         "react-dom":  "^19.0.0",
                         "react-markdown":  "^10.1.0",
                         "recharts":  "^3.10.1",
                         "rxjs":  "7.8.1",
                         "tailwind-merge":  "^3.5.0",
                         "vite":  "^6.2.0",
                         "zod":  "4.6.7"
                     },
    "devDependencies":  {
                            "@playwright/test":  "^1.63.0",
                            "@types/bun":  "^1.4.2",
                            "@types/node":  "^22.14.0",
                            "autoprefixer":  "^10.4.21",
                            "copilotkit":  "4.29.0",
                            "tailwindcss":  "^4.1.14",
                            "typescript":  "~5.8.2",
                            "vite":  "^6.2.0"
                        },
    "packageManager":  "bun@1.4.2",
    "overrides": {
        "@grpc/grpc-js": "1.13.6",
        "source-map-js": "1.2.2"
    }
}
