                         "date-fns":  "^4.1.0",
                         "dotenv":  "^17.2.3",
                         "firebase":  "^12.19.0",
                         "framer-motion":  "^12.34.3",
                         "lucide-react":  "^0.546.0",
                         "motion":  "^12.23.24",
                         "react":  "^19.0.0",
                         "react-dom":  "^19.0.0",
                         "react-markdown":  "^10.1.0",
